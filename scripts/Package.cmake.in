cmake_minimum_required(VERSION 3.20)

if(NOT "@WIN32@" OR "@STARFALL_USE_SYSTEM_SDL2@" OR NOT "@CMAKE_SIZEOF_VOID_P@" EQUAL 8)
    message(FATAL_ERROR "Portable packaging supports the bundled Windows x64 dependency route only.")
endif()

if(NOT "@BUILD_TESTING@")
    message(FATAL_ERROR "Release packaging requires BUILD_TESTING=ON and both registered test groupings.")
endif()
set(stage "@STARFALL_PACKAGE_STAGE@")
set(output "@STARFALL_PACKAGE_OUTPUT@")
set(archive "${output}/Starfall-Windows-x64.zip")
if(EXISTS "${stage}" OR EXISTS "${archive}" OR EXISTS "${archive}.sha256")
    message(FATAL_ERROR "Use a fresh package stage and output directory. Existing files are preserved: ${stage}; ${archive}")
endif()

# Record committed provenance. A source ZIP carries this small generated marker
# because it deliberately excludes Git metadata and generated executables.
set(commit "")
if(EXISTS "@CMAKE_CURRENT_SOURCE_DIR@/.git" AND EXISTS "@GIT_EXECUTABLE@")
    execute_process(COMMAND "@GIT_EXECUTABLE@" -C "@CMAKE_CURRENT_SOURCE_DIR@" rev-parse HEAD
        RESULT_VARIABLE git_result OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(COMMAND "@GIT_EXECUTABLE@" -C "@CMAKE_CURRENT_SOURCE_DIR@" status --porcelain --untracked-files=normal
        RESULT_VARIABLE status_result OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT git_result EQUAL 0 OR NOT status_result EQUAL 0 OR NOT dirty STREQUAL "")
        message(FATAL_ERROR "Commit tracked source changes before making a release package.")
    endif()
elseif(EXISTS "@CMAKE_CURRENT_SOURCE_DIR@/SOURCE-COMMIT.txt")
    file(READ "@CMAKE_CURRENT_SOURCE_DIR@/SOURCE-COMMIT.txt" commit)
    string(STRIP "${commit}" commit)
else()
    message(FATAL_ERROR "Release provenance is missing. Use a committed checkout or the complete source ZIP.")
endif()
string(LENGTH "${commit}" commit_length)
if(NOT commit_length EQUAL 40 OR NOT commit MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Expected a full Git source commit, got: ${commit}")
endif()

execute_process(COMMAND "@CMAKE_CTEST_COMMAND@" --test-dir "@CMAKE_CURRENT_BINARY_DIR@"
    -C "${STARFALL_PACKAGE_CONFIG}" --output-on-failure RESULT_VARIABLE tests_result)
if(NOT tests_result EQUAL 0)
    message(FATAL_ERROR "Release checks failed; no package was installed or archived.")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
    --config "${STARFALL_PACKAGE_CONFIG}" --prefix "${stage}" RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "Runtime installation failed; no ZIP was created. Preserve the stage for diagnosis and choose a fresh stage on retry.")
endif()

set(manifest "{}")
string(JSON manifest SET "${manifest}" format "\"Starfall-package-v1\"")
string(JSON manifest SET "${manifest}" source_commit "\"${commit}\"")
string(JSON manifest SET "${manifest}" project_version "\"@PROJECT_VERSION@\"")
string(JSON manifest SET "${manifest}" platform "\"Windows-x64\"")
string(JSON manifest SET "${manifest}" compiler "\"@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\"")
string(JSON manifest SET "${manifest}" configuration "\"${STARFALL_PACKAGE_CONFIG}\"")
string(JSON manifest SET "${manifest}" dependencies "{\"SDL2\":\"2.30.10\",\"SDL2_image\":\"2.8.8\",\"SDL2_ttf\":\"2.24.0\",\"SDL2_mixer\":\"2.8.1\",\"FreeType\":\"2.13.3 (static)\"}")
string(JSON manifest SET "${manifest}" reference_revision "\"a9b224196ad57fcfd6da2f70fd989ca4fa6ab5e1\"")
string(JSON manifest SET "${manifest}" files "[]")
file(GLOB_RECURSE installed_files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
list(SORT installed_files)
set(index 0)
foreach(relative IN LISTS installed_files)
    file(SIZE "${stage}/${relative}" bytes)
    file(SHA256 "${stage}/${relative}" digest)
    set(entry "{}")
    string(JSON entry SET "${entry}" path "\"${relative}\"")
    string(JSON entry SET "${entry}" bytes "${bytes}")
    string(JSON entry SET "${entry}" sha256 "\"${digest}\"")
    string(JSON manifest SET "${manifest}" files ${index} "${entry}")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${stage}/PACKAGE-MANIFEST.json" "${manifest}\n")
file(MAKE_DIRECTORY "${output}")
file(GLOB top_level RELATIVE "${stage}" "${stage}/*")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${archive}" --format=zip -- ${top_level}
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE archive_result)
if(NOT archive_result EQUAL 0)
    message(FATAL_ERROR "Archive creation failed; do not use the partial ZIP.")
endif()
file(SHA256 "${archive}" archive_digest)
file(WRITE "${archive}.sha256" "${archive_digest}  Starfall-Windows-x64.zip\n")
message(STATUS "Portable package: ${archive}")
message(STATUS "SHA-256: ${archive_digest}")
